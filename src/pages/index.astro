---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import WritingListItem from '../components/WritingListItem.astro';
import ProjectPreview from '../components/ProjectPreview.astro';

const writing = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const projects = (await getCollection('projects', ({ data }) => !data.draft))
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<SiteLayout>
	<section class="hero page">
		<div class="hero-copy">
			<p class="eyebrow">Systems / software / experiments</p>
			<h1>Systems and tools that earn their keep.</h1>
			<p class="hero-dek">I work across infrastructure, cloud, AI enablement, automation, developer tooling, and software. This is a place to keep useful notes on the work and the ideas around it.</p>
			<div class="hero-links"><a href="/writing">Read the writing <span aria-hidden="true">&#8594;</span></a><a href="/lab">Visit the lab <span aria-hidden="true">&#8594;</span></a></div>
		</div>
		<aside class="focus-note">
			<p class="meta">A few enduring interests</p>
			<ul><li>Applied AI with real constraints</li><li>Calmer developer environments</li><li>Automation that earns its place</li></ul>
		</aside>
	</section>

	<section class="section page" aria-labelledby="writing-heading">
		<div class="section-heading"><div><p class="eyebrow">Recent notes</p><h2 id="writing-heading">From the notebook</h2></div><a class="section-link" href="/writing">All writing &#8594;</a></div>
		{writing.length > 0 ? <div>{writing.slice(0, 3).map((entry, index) => <WritingListItem entry={entry} featured={index === 0} />)}</div> : <p class="empty">The first notes are being prepared.</p>}
	</section>

	<section class="section page" aria-labelledby="lab-heading">
		<div class="section-heading"><div><p class="eyebrow">Work in progress</p><h2 id="lab-heading">The lab</h2></div><a class="section-link" href="/lab">All experiments &#8594;</a></div>
		{projects.length > 0 ? <div class:list={['project-grid', { single: projects.length === 1 }]}>{projects.slice(0, 2).map((project) => <ProjectPreview entry={project} />)}</div> : <p class="empty">Experiments will appear here when they are ready to share.</p>}
	</section>

	<section class="section page about-strip" aria-labelledby="about-heading">
		<div><p class="eyebrow">A little context</p><h2 id="about-heading">The work between the disciplines.</h2></div>
		<div><p>I enjoy problems that sit between disciplines: systems that need to be reliable, tools that need to be humane, and new technology that needs to prove its usefulness.</p><a href="/about">More about how I think &#8594;</a></div>
	</section>
</SiteLayout>
<style>
	.hero { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; min-height: min(44rem, calc(100vh - 4.6rem)); gap: clamp(2rem, 7vw, 8rem); align-items: end; padding-top: clamp(4rem, 9vw, 9rem); padding-bottom: clamp(4rem, 9vw, 8rem); }
	.hero-copy h1 { max-width: 12ch; margin: 0.4rem 0 1.3rem; font-size: clamp(3.25rem, 7.4vw, 7.1rem); line-height: 0.91; letter-spacing: -0.075em; }
	.hero-dek { max-width: 56ch; margin: 0; color: var(--muted); font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem); line-height: 1.5; }
	.hero-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; }
	.hero-links a, .about-strip a { color: var(--ink); font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.04em; text-decoration: none; text-transform: uppercase; }
	.hero-links a span, .about-strip a { color: var(--accent-ink); }
	.focus-note { align-self: end; padding-left: 1rem; border-left: 1px solid var(--rule); }
	.focus-note p { margin: 0 0 0.75rem; }
	.focus-note ul { margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: 0.83rem; line-height: 1.45; }
	.focus-note li + li { margin-top: 0.65rem; }
	.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.project-grid.single { max-width: 36rem; grid-template-columns: 1fr; }
	.about-strip { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 8vw, 8rem); }
	.about-strip h2 { max-width: 13ch; margin: 0.35rem 0 0; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -0.06em; }
	.about-strip > div:last-child { max-width: 34rem; color: var(--muted); }
	.about-strip a { display: inline-block; margin-top: 0.5rem; }
	.empty { color: var(--muted); }
	@media (max-width: 700px) { .hero { grid-template-columns: 1fr; min-height: auto; gap: 3.5rem; padding-top: 4.5rem; } .focus-note { max-width: 20rem; } .project-grid, .about-strip { grid-template-columns: 1fr; } .about-strip { gap: 1.5rem; } }
</style>
