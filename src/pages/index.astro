---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import WritingListItem from '../components/WritingListItem.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL } from '../consts';
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.updatedDate?.valueOf() ?? 0) - (a.data.updatedDate?.valueOf() ?? 0));
---
<SiteLayout>
 <section class="hero page" aria-labelledby="hero-heading">
  <div class="hero-copy reveal"><p class="eyebrow">Huzaifa / Engineer & builder / Vancouver, BC</p><h1 id="hero-heading">Hi, I’m Huzaifa.<br />I work on<br /><span>systems &amp; tools.</span></h1><p class="hero-dek">My work spans infrastructure, developer platforms, and applied AI. This is where I share the tools I’m building, what I’m learning, and the occasional deep dive into how something works.</p><div class="hero-links"><a class="button" href="#selected-work">Explore the work <span aria-hidden="true">↘</span></a><a class="hero-about" href="/about">A little about me <span aria-hidden="true">↗</span></a></div><div class="availability"><span class="availability-dot"></span><span>Open to interesting problems & new opportunities</span></div></div>
  <div class="hero-visual reveal later"><SystemDiagram /></div>
 </section>
 <div class="practice-strip page"><span class="mono">Working across</span><div><span>Infrastructure</span><i>/</i><span>Developer platforms</span><i>/</i><span>Applied AI</span><i>/</i><span>Automation</span></div><span class="practice-end" aria-hidden="true">↳</span></div>
 <section class="section page work-section" id="selected-work" aria-labelledby="lab-heading"><div class="section-heading"><div><p class="eyebrow">01 / Selected experiments</p><h2 id="lab-heading">Ideas, put to work.</h2></div><a class="section-link" href="/lab">Inside the lab <span aria-hidden="true">↗</span></a></div><p class="section-intro">Things I’m building to make operational work clearer, safer, and a little less manual.</p>{projects.length > 0 ? <div class="project-grid">{projects.slice(0, 3).map((project, index) => <ProjectPreview entry={project} index={index} />)}</div> : <p>Experiments will appear here when they are ready to share.</p>}</section>
 <section class="section page writing-section" aria-labelledby="writing-heading"><div class="writing-intro"><p class="eyebrow">02 / Field notes</p><h2 id="writing-heading">Thinking<br />in public.</h2><p>Notes from building things, following the interesting questions, and occasionally getting far too familiar with an API.</p><a class="section-link" href="/writing">All writing <span aria-hidden="true">↗</span></a></div><div class="writing-preview">{writing.slice(0, 3).map((entry) => <WritingListItem entry={entry} />)}</div></section>
 <section class="section page practice-section" aria-labelledby="practice-heading"><div><p class="eyebrow">03 / How I work</p><h2 id="practice-heading">A systems view.<br />Hands on the tools.</h2><a class="section-link" href="/about">More about my approach <span aria-hidden="true">↗</span></a></div><div class="practice-copy"><p>I’m most useful where disciplines meet: a cloud estate that needs to become a platform, a manual process ready for automation, or an AI prototype that needs to work on an ordinary Tuesday.</p><p>I care about technology that people can understand, operate, and trust. The interesting work is making all three happen at once.</p><div class="practice-tags"><span>Cloud & platform architecture</span><span>Terraform & CI/CD</span><span>Developer experience</span><span>Applied AI & agents</span><span>Technical leadership</span></div></div></section>
 <section class="contact-section" aria-labelledby="contact-heading"><div class="contact-inner page"><div><p class="eyebrow">Good work starts with a conversation</p><h2 id="contact-heading">Something worth<br />building<span>?</span></h2><p>I’m exploring my next chapter and take on select consulting engagements. If you have an interesting problem, I’d like to hear about it.</p></div><div class="contact-actions"><a class="button" href={`mailto:${CONTACT_EMAIL}`}>Let’s talk <span aria-hidden="true">↗</span></a><div><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div></div></section>
</SiteLayout>
<style>
.hero { display: grid; grid-template-columns: 1.18fr 1fr; align-items: center; gap: 3.5rem; padding-top: clamp(4rem, 6.3vw, 6.5rem); padding-bottom: 4.7rem; }
.hero-copy .eyebrow { font-size: 0.6rem; letter-spacing: 0.05em; }
h1 { margin: 1.7rem 0 1.6rem; font-size: clamp(3.4rem, 5.5vw, 5.7rem); line-height: 1.035; letter-spacing: -0.067em; }h1 > span { color: var(--accent); }
.hero-dek { max-width: 44ch; margin: 0; color: var(--muted); font-size: 1.02rem; line-height: 1.75; }
.hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.7rem; margin-top: 2rem; }.hero-about { display: inline-flex; align-items: center; gap: 0.8rem; padding: 0.7rem 0; font-size: 0.8rem; text-decoration: none; }.hero-about span { color: var(--muted); }
.availability { display: flex; align-items: center; gap: 0.5rem; margin-top: 2.2rem; font-family: var(--font-mono); font-size: 0.56rem; color: var(--muted); }.availability-dot { width: 6px; height: 6px; flex: 0 0 auto; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 10%, transparent); }
.hero-visual { align-self: center; padding-top: 0.3rem; }
.practice-strip { display: flex; align-items: center; gap: 2.8rem; padding-top: 1.25rem; padding-bottom: 1.25rem; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }.practice-strip > .mono { flex-shrink: 0; color: var(--muted); font-size: 0.56rem; }.practice-strip > div { display: flex; align-items: center; justify-content: space-between; flex: 1; gap: 1rem; font-family: var(--font-display); font-size: 0.85rem; }.practice-strip i { font-style: normal; color: var(--rule); }.practice-end { margin-left: auto; font-size: 1.3rem; color: var(--accent); }
.work-section { border-top: 0; }.section-intro { margin: -1.1rem 0 2rem; max-width: 55ch; color: var(--muted); font-size: 0.9rem; }.project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
.writing-section { display: grid; grid-template-columns: 1fr 2fr; gap: 5rem; }.writing-intro h2 { margin: 0 0 1.5rem; font-size: clamp(2.5rem, 4vw, 3.8rem); line-height: 1.05; letter-spacing: -0.06em; }.writing-intro > p:not(.eyebrow) { color: var(--muted); font-size: 0.9rem; max-width: 28ch; margin-bottom: 1.5rem; }.writing-preview :global(.writing-item:first-child) { padding-top: 0; border-top: 0; }.writing-preview :global(.writing-item:last-child) { border-bottom: 0; padding-bottom: 0; }
.practice-section { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; }.practice-section h2 { margin: 0 0 1.5rem; font-size: clamp(2.3rem, 3.7vw, 3.5rem); letter-spacing: -0.055em; line-height: 1.1; }.practice-copy { color: var(--muted); font-size: 0.98rem; }.practice-copy > p:first-child { margin-top: 0; }.practice-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }.practice-tags span { border: 1px solid var(--rule); padding: 0.25rem 0.55rem; font-size: 0.63rem; font-family: var(--font-mono); }
.contact-section { background: var(--surface); border-top: 1px solid var(--rule); }.contact-inner { display: flex; align-items: end; justify-content: space-between; gap: 3rem; padding-top: 4.5rem; padding-bottom: 4.5rem; }.contact-inner h2 { margin: 0 0 1.5rem; font-size: clamp(3rem, 5.5vw, 5rem); line-height: 1.04; letter-spacing: -0.065em; }.contact-inner h2 span { color: var(--accent); }.contact-inner p:not(.eyebrow) { max-width: 54ch; margin: 0; color: var(--muted); font-size: 0.92rem; }.contact-actions { min-width: 13rem; }.contact-actions > .button { width: 100%; justify-content: space-between; }.contact-actions > div { display: flex; justify-content: space-between; margin-top: 1.3rem; font-size: 0.75rem; }.contact-actions > div a { text-decoration: none; }
@media (min-width: 1500px) { .hero { padding-top: 6rem; padding-bottom: 5.5rem; } }
@media (max-width: 1000px) { .hero { gap: 2rem; }.hero-copy .eyebrow { font-size: 0.5rem; }.practice-strip { gap: 1.5rem; }.practice-strip > div { font-size: 0.75rem; }.writing-section { gap: 3rem; }.practice-section { gap: 3rem; } }
@media (max-width: 850px) { .hero { grid-template-columns: 1fr 0.8fr; gap: 1.5rem; }h1 { font-size: clamp(3rem, 6.6vw, 4rem); }.hero-dek { font-size: 0.95rem; }.hero-links { gap: 1rem; }.hero-links .button { gap: 1rem; }.hero-about { font-size: 0.7rem; }.availability { font-size: 0.5rem; }.project-grid { grid-template-columns: 1fr; gap: 1.5rem; }.project-grid :global(.project-preview) { display: grid; grid-template-columns: 1fr 1.15fr; }.project-grid :global(.project-art) { border-bottom: 0; border-right: 1px solid var(--rule); height: 100%; min-height: 16rem; }.practice-end { display: none; }.practice-strip { flex-wrap: wrap; gap: 0.75rem; }.practice-strip > div { min-width: 100%; }.writing-section { grid-template-columns: 1fr; gap: 2rem; }.writing-intro h2 br { display: none; }.writing-intro { display: grid; grid-template-columns: 1fr auto; }.writing-intro > p, .writing-intro h2 { grid-column: 1; }.writing-intro > p:not(.eyebrow) { max-width: 50ch; margin: 0; }.writing-intro .section-link { grid-column: 2; grid-row: 2; align-self: end; }.practice-section { gap: 2rem; } }
@media (max-width: 600px) { .hero { grid-template-columns: 1fr; padding-top: 3.25rem; padding-bottom: 2rem; gap: 2.5rem; }.hero-copy .eyebrow { font-size: 0.53rem; }h1 { font-size: clamp(3.3rem, 10.5vw, 4.8rem); margin-top: 1.5rem; }.hero-dek { max-width: 43ch; }.hero-visual { width: min(100%, 25rem); justify-self: center; }.availability { margin-top: 1.6rem; font-size: 0.52rem; }.hero-links { gap: 1.5rem; }.hero-about { font-size: 0.77rem; }.practice-strip > div { flex-wrap: wrap; justify-content: start; column-gap: 0.7rem; row-gap: 0.4rem; font-size: 0.72rem; }.practice-strip > div i:last-of-type { display: none; }.project-grid :global(.project-preview) { display: block; }.project-grid :global(.project-art) { border-right: 0; border-bottom: 1px solid var(--rule); min-height: 15rem; }.section-heading h2 { font-size: 2rem; }.section-intro { margin-top: -0.8rem; font-size: 0.85rem; }.practice-section { grid-template-columns: 1fr; gap: 2rem; }.contact-inner { flex-direction: column; align-items: start; padding-top: 3rem; padding-bottom: 3rem; gap: 2rem; }.contact-actions { width: 100%; }.contact-actions > div { justify-content: start; gap: 2rem; }.writing-intro { display: block; }.writing-intro .section-link { margin-top: 1rem; } }
</style>
