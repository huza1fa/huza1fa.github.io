---
interface Props { label: string; href?: string; }
const { label, href } = Astro.props;
---
{href ? <a class="tag" href={href}>{label}</a> : <span class="tag">{label}</span>}
<style>
	.tag { display: inline-block; color: var(--muted); text-decoration: none; }
	a.tag:hover { color: var(--accent-ink); }
</style>
