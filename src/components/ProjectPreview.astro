---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
interface Props { entry: CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const { title, description, status, technologies, placeholder } = entry.data;
---

<article class="project-preview">
	<div class="project-top">
		<p class="meta">{placeholder ? 'placeholder' : status}</p>
		<span class="project-marker" aria-hidden="true"></span>
	</div>
	<h2><a href={`/lab/${entry.id}/`}>{title}</a></h2>
	<p>{description}</p>
	<div class="project-tags">{technologies.map((technology) => <Tag label={technology} />)}</div>
</article>
<style>
	.project-preview { display: flex; min-height: 15rem; flex-direction: column; padding: 1.35rem; border: 1px solid var(--rule); background: var(--surface); transition: border-color 180ms ease, transform 180ms ease; }
	.project-preview:hover { border-color: var(--accent); transform: translateY(-2px); }
	.project-top { display: flex; align-items: center; justify-content: space-between; }
	.project-top p { margin: 0; }
	.project-marker { width: 0.5rem; height: 0.5rem; background: var(--accent); }
	.project-preview h2 { max-width: 18ch; margin: auto 0 0.55rem; font-size: 1.35rem; line-height: 1.15; letter-spacing: -0.03em; }
	.project-preview h2 a { color: var(--ink); text-decoration: none; }
	.project-preview h2 a:hover { color: var(--accent-ink); }
	.project-preview > p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.55; }
	.project-tags { display: flex; flex-wrap: wrap; gap: 0.5rem 0.85rem; margin-top: 1rem; }
	.project-tags :global(.tag) { font-size: 0.63rem; }
</style>
