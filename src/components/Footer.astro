---
import { GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer"><div class="page footer-inner"><p>© {year} {SITE_TITLE}<span class="footer-note">Personal site &amp; technical notebook.</span></p><div class="footer-links"><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="/rss.xml">RSS ↗</a></div><a class="back-top" href="#main-content" aria-label="Back to top">↑</a></div></footer>
<style>
.site-footer { border-top: 1px solid var(--rule); }
.footer-inner { display: flex; align-items: center; gap: 2rem; padding-top: 1.75rem; padding-bottom: 1.75rem; color: var(--muted); font-size: 0.72rem; }
.footer-inner p { margin: 0; }.footer-note { margin-left: 1.5rem; color: var(--faint); }
.footer-links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-left: auto; }.footer-links a { text-decoration: none; }
.back-top { text-decoration: none; color: var(--ink); font-size: 1.2rem; }
@media (max-width: 900px) { .footer-note { display: none; } }
@media (max-width: 500px) { .footer-inner { flex-wrap: wrap; gap: 1rem; } .footer-links { order: 3; margin: 0; width: 100%; } .back-top { margin-left: auto; } }
</style>
