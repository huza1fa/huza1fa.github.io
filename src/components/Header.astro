---
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="site-header">
 <div class="header-inner page">
  <a class="wordmark" href="/" aria-label={`${SITE_TITLE}, home`}><span class="brand-symbol" aria-hidden="true">h<span>.</span></span><span>huzaifa<span class="wordmark-period">.</span></span></a>
  <nav aria-label="Primary navigation"><HeaderLink href="/">Overview</HeaderLink><HeaderLink href="/lab">Lab</HeaderLink><HeaderLink href="/writing">Writing</HeaderLink><HeaderLink href="/about">About</HeaderLink></nav>
  <div class="header-actions"><ThemeToggle /><a class="contact-link" href={`mailto:${CONTACT_EMAIL}`}>Let’s talk <span aria-hidden="true">↗</span></a></div>
 </div>
</header>
<style>
.site-header { border-bottom: 1px solid var(--rule); }
.header-inner { display: flex; justify-content: space-between; align-items: center; min-height: 6rem; gap: 2rem; }
.wordmark { display: flex; align-items: center; gap: 0.75rem; color: var(--ink); font-family: var(--font-display); font-size: 1.3rem; letter-spacing: -0.06em; text-decoration: none; }
.brand-symbol { display: flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; background: var(--ink); color: var(--paper); font-size: 1.4rem; font-weight: 700; letter-spacing: -0.12em; padding-right: 0.12em; }
.brand-symbol span, .wordmark-period { color: var(--accent); }
nav { display: flex; align-items: center; gap: 2.2rem; }
nav :global(a) { position: relative; padding: 0.5rem 0; font-size: 0.78rem; text-decoration: none; color: var(--muted); transition: color 180ms; }
nav :global(a:hover), nav :global(a.active) { color: var(--ink); }
nav :global(a.active)::after { content: ''; position: absolute; width: 0.25rem; height: 0.25rem; border-radius: 50%; background: var(--accent); bottom: 0; left: calc(50% - 0.125rem); }
.header-actions { display: flex; align-items: center; gap: 1.2rem; }
.contact-link { font-size: 0.78rem; text-decoration: none; }
.contact-link span { margin-left: 0.7rem; color: var(--accent); }
@media (max-width: 700px) { .header-inner { gap: 1rem; flex-wrap: wrap; min-height: 0; padding-top: 1rem; padding-bottom: 0.75rem; } nav { order: 3; width: 100%; justify-content: space-between; gap: 1rem; } .wordmark { font-size: 1.15rem; } .header-actions { gap: 0.75rem; } }
</style>
