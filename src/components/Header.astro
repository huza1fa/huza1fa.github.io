---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<div class="header-inner page">
		<a class="wordmark" href="/" aria-label={`${SITE_TITLE}, home`}>{SITE_TITLE}<span aria-hidden="true">.</span></a>
		<nav aria-label="Primary navigation">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/writing">Writing</HeaderLink>
			<HeaderLink href="/lab">Lab</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		<ThemeToggle />
	</div>
</header>
<style>
	.site-header { border-bottom: 1px solid var(--rule); }
	.header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 4.6rem; gap: 1.5rem; }
	.wordmark { color: var(--ink); font-size: 1.08rem; font-weight: 700; letter-spacing: -0.04em; text-decoration: none; }
	.wordmark span { color: var(--accent); }
	nav { display: flex; gap: 0.15rem; }
	nav :global(a) { padding: 0.5rem 0.65rem; color: var(--muted); font-size: 0.86rem; text-decoration: none; transition: color 180ms ease; }
	nav :global(a:hover), nav :global(a.active) { color: var(--ink); }
	nav :global(a.active) { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.45rem; }
	.header-inner :global(.theme-toggle) { justify-self: end; }
	@media (max-width: 620px) { .header-inner { grid-template-columns: 1fr auto; gap: 0.5rem; min-height: auto; padding-top: 0.65rem; padding-bottom: 0.65rem; } nav { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; } nav :global(a) { padding: 0.45rem 0; font-size: 0.78rem; } }
</style>
