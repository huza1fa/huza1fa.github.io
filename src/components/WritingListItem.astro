---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../utils/content';
interface Props { entry: CollectionEntry<'writing'>; featured?: boolean; }
const { entry, featured = false } = Astro.props;
const { title, description, publishDate, category, placeholder } = entry.data;
---
<article class:list={['writing-item', { featured }]} data-category={category}>
 <div class="item-meta meta"><span>{placeholder ? 'Placeholder' : category}</span><span class="item-time"><time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time><span aria-hidden="true">·</span>{readingTime(entry.body)} min read</span></div>
 <h2><a href={`/writing/${entry.id}/`}>{title}<span class="item-arrow" aria-hidden="true">↗</span></a></h2><p>{description}</p>
</article>
<style>
.writing-item { position: relative; min-width: 0; padding: 1.6rem 0; border-top: 1px solid var(--rule); }.writing-item:last-child { border-bottom: 1px solid var(--rule); }
.item-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; font-size: 0.54rem; letter-spacing: 0.04em; }.item-meta > span:first-child { color: var(--accent-ink); }.item-time { display: inline-flex; gap: 0.5rem; }
h2 { margin: 0.75rem 0 0.65rem; font-size: clamp(1.2rem, 1.65vw, 1.6rem); line-height: 1.3; letter-spacing: -0.035em; }h2 a { display: block; padding-right: 2rem; color: var(--ink); text-decoration: none; }h2 a::after { position: absolute; content: ''; inset: 0; }.item-arrow { position: absolute; right: 0; color: var(--faint); font-size: 1.05rem; transition: color 180ms, transform 180ms; }.writing-item:hover .item-arrow { color: var(--accent); transform: translate(2px, -2px); }.writing-item:hover h2 a { color: var(--accent-ink); }
p { max-width: 70ch; margin: 0; color: var(--muted); font-size: 0.85rem; line-height: 1.65; }
@media (max-width: 600px) { .item-meta { font-size: 0.52rem; }h2 { font-size: 1.25rem; }.writing-item { padding: 1.5rem 0; } }
</style>
